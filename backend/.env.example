# PostgreSQL (локальный или Supabase)
# Локальный: createdb medi, затем:
DATABASE_URL=postgresql+psycopg://YOUR_USER@localhost:5432/medi

# Supabase — connection pooler (IPv4):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=*
DEBUG_DEMO_OTP=true

# ИИ-чат (OpenAI-совместимый API)
# Groq (бесплатно, console.groq.com):
# OPENAI_API_BASE=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile

# Google Gemini:
# OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIza...
# OPENAI_MODEL=gemini-2.0-flash

# Ollama (локально):
# OPENAI_API_BASE=http://127.0.0.1:11434/v1
# OPENAI_MODEL=llama3.2
