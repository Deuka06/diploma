# Без Docker: SQLite (файл backend/data/medi.db создаётся сам)
DATABASE_URL=sqlite:///./data/medi.db

# С PostgreSQL (локально или в Docker) раскомментируйте и подставьте свои данные:
# DATABASE_URL=postgresql+psycopg://medi:medi@localhost:5432/medi

JWT_SECRET=change-me-in-development-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# * — все источники (удобно для Flutter/mobile). Уточните домены для продакшена.
CORS_ORIGINS=*

# --- Реальный ИИ в чате (POST /chat/message) — OpenAI-совместимый /chat/completions ---
#
# Бесплатно «по-настоящему»:
#   • Groq — зарегистрируйтесь на https://console.groq.com → API Keys → создать ключ (gsk_...).
#   • Ollama — https://ollama.com , локально без облака: ollama pull llama3.2, см. вариант 3.
# Готовый токен в проект не вставляют — только свой ключ из личного кабинета.
#
# Вариант 1 — OpenAI (ключ с platform.openai.com):
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# Вариант 2 — Groq (быстро, ключ с console.groq.com):
# OPENAI_API_BASE=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# Вариант 3 — Ollama на этой же машине (ключ можно не задавать):
# OPENAI_API_BASE=http://127.0.0.1:11434/v1
# OPENAI_MODEL=llama3.2
#
# Если ключ не задан и base не localhost — ответы будут текстовыми заглушками.
